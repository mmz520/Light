{
  "name": "dont-starve-steampunk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "类饥荒生存编辑器（动画 / 世界 / 数据）",
  "author": "Light Team",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build:web": "tsc --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "npm run build && node scripts/run-electron.mjs",
    "selftest": "node scripts/build-electron.mjs && node scripts/run-electron.mjs --selftest",
    "smoke": "node scripts/run-electron.mjs --smoke",
    "shot": "node scripts/run-electron.mjs --shot",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "record": "node scripts/record-demo.mjs",
    "test:headless": "node scripts/runtime-headless.mjs"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@xyflow/react": "^12.12.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
