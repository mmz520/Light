      "schema": {
        "joint": {
          "id": "string（唯一，编辑器节点 id）",
          "parent": "string | null（根关节为 null）",
          "slot": "string（图像槽 = parts/{slot}/ 目录名；同 slot 共图）",
          "pivot": "top | bottom | center",
          "mirrorOf": "string?（可选，声明该节点由另一节点水平镜像复用贴图）",
          "optional": "boolean?（可选，缺件时不报错）",
          "scale": "number?（可选，共用图的缩放系数）",
          "layout": {
            "cx": "number",
            "bottom": "number | top: number",
            "h": "number"
          },
          "z": "number（渲染层级，大的在上）"
        }
      },
